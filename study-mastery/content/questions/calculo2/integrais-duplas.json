  "subtopic": "Região triangular",
  "difficulty": "medio",
  "scope": "aula",
  "type": "multiple-choice",
  "stem": "Calcule $\\displaystyle\\int_0^1\\!\\int_0^x (x+3y)\\,dy\\,dx$.",
  "options": [
   {
