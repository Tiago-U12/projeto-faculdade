   "steps": [
    "$\\int_0^1 xy\\,dy=\\dfrac{x}{2}$.",
    "$\\int_1^2\\dfrac{x}{2}\\,dx=\\dfrac12\\cdot\\dfrac32$.",
    "$=\\dfrac34$."
