 {
  "id": "c2-funcoes-2-var-001",
  "disciplineId": "calculo2",
  "topicId": "funcoes-2-var",
  "subtopic": "Valor numérico",
  "difficulty": "facil",
  "scope": "aula",
  "type": "multiple-choice",
  "stem": "Seja $f(x,y)=3x-y^{2}$. Calcule $f(2,-3)$.",
  "options": [
   {
    "id": "a",
    "text": "$3$"
   },
   {
    "id": "b",
    "text": "$-3$"
   },
   {
    "id": "c",
    "text": "$15$"
   },
   {
    "id": "d",
    "text": "$-15$"
   }
  ],
  "correctOptionId": "b",
  "explanation": {
   "correct": "Substitua $x=2$ e $y=-3$: $f(2,-3)=3\\cdot2-(-3)^{2}=6-9=-3$.",
   "steps": [
    "$3x=3\\cdot2=6$.",
    "$y^{2}=(-3)^{2}=9$.",
    "$f(2,-3)=6-9=-3$."
   ],
   "wrong": {
    "c": "Ao calcular $y^2$ com $y=-3$ obtém-se $+9$, mas o termo entra com sinal negativo: $6-9=-3$, e não $6+9$.",
    "a": "Trocou o sinal do resultado: $3\\cdot2-(-3)^2=6-9=-3$.",
    "d": "Aplicou o sinal negativo também a $3x$: $-6-9=-15$. Só $y^2$ é subtraído."
   }
  },
  "sourceRefs": [
   {
    "sourceId": "c2-f2v-intro",
    "locator": "exemplo 1: valor da função em pares ordenados",
    "usage": "aula"
   }
  ],
  "status": "approved",
  "version": 1,
