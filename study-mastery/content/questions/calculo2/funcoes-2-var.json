  "updatedAt": "2026-10-22T23:42:43.108Z",
  "verification": {
   "kind": "expr",
   "params": {
    "expr": "subs(subs(3*x-y**2,x,2),y,-3)",
    "numeric": "6-9"
   },
   "optionValues": {
    "b": "-3",
    "c": "15",
