  "difficulty": "facil",
  "scope": "aula",
  "type": "multiple-choice",
  "stem": "A demanda semanal de iogurte (em unidades) é $q=120-3x+2y$, em que $x$ é o preço do iogurte e $y$ é o preço de um produto substituto. Qual é a demanda se $x=15$ e $y=10$?",
  "options": [
   {
    "id": "a",
    "text": "$95$"
   },
   {
    "id": "b",
    "text": "$145$"
   },
   {
    "id": "c",
    "text": "$55$"
   },
   {
    "id": "d",
    "text": "$85$"
   }
  ],
  "correctOptionId": "a",
  "explanation": {
   "correct": "Substituindo: $q=120-3\\cdot15+2\\cdot10=120-45+20=95$ unidades.",
   "steps": [
    "$-3x=-45$ e $2y=20$.",
    "$q=120-45+20$.",
    "$q=95$."
   ],
   "wrong": {
    "c": "Subtraiu o termo do substituto: o coeficiente de $y$ é $+2$, logo soma-se $2\\cdot10=20$.",
    "d": "Usou $-3x+y$ (esqueceu o coeficiente $2$ de $y$): $120-45+10=85$.",
    "b": "Inverteu os sinais dos dois termos ($120+45-20$): o preço próprio reduz a demanda ($-3x$) e o substituto a aumenta ($+2y$)."
   }
  },
  "sourceRefs": [
