  "difficulty": "facil",
  "scope": "aula",
  "type": "multiple-choice",
  "stem": "Qual é o ponto crítico de $f(x,y)=x^{2}+y^{2}-4x+6y$?",
  "options": [
   {
    "id": "a",
    "text": "$(-2,3)$"
   },
   {
    "id": "b",
