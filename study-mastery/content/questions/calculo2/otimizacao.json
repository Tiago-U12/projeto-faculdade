 {
  "id": "c2-otimizacao-002",
  "disciplineId": "calculo2",
  "topicId": "otimizacao",
  "subtopic": "Teste da Hessiana (mínimo)",
  "difficulty": "facil",
  "scope": "aula",
  "type": "multiple-choice",
  "stem": "Para $f(x,y)=x^{2}+y^{2}$, a origem é ponto crítico. Como ele se classifica?",
  "options": [
   {
    "id": "a",
    "text": "ponto de sela"
   },
   {
    "id": "b",
    "text": "o teste é inconclusivo"
   },
   {
    "id": "c",
    "text": "ponto de máximo local"
   },
   {
    "id": "d",
    "text": "mínimo local ($D=4>0$, $f_{xx}>0$)"
   }
  ],
  "correctOptionId": "d",
  "explanation": {
   "correct": "$f_{xx}=2$, $f_{yy}=2$, $f_{xy}=0$. O discriminante é $D=f_{xx}f_{yy}-f_{xy}^2=4>0$ e $f_{xx}>0$, portanto a origem é mínimo local (de valor $0$).",
   "steps": [
    "$f_{xx}=2,\\ f_{yy}=2,\\ f_{xy}=0$.",
    "$D=2\\cdot2-0=4>0$.",
    "$D>0$ e $f_{xx}>0$ ⇒ mínimo."
   ],
   "wrong": {
    "c": "O máximo exigiria $f_{xx}<0$; aqui $f_{xx}=2>0$.",
    "a": "A sela exigiria $D<0$; aqui $D=f_{xx}f_{yy}-f_{xy}^2=4>0$.",
    "b": "Só seria inconclusivo se $D=0$; aqui $D=4\\neq0$."
   }
  },
  "sourceRefs": [
   {
    "sourceId": "c2-programa",
    "locator": "conteúdo programático: otimização",
    "usage": "aula"
   }
  ],
  "status": "approved",
  "version": 1,
  "createdAt": "2026-10-23T00:53:24.844Z",
  "updatedAt": "2026-10-23T00:53:47.424Z",
  "verification": {
   "kind": "expr",
   "params": {
    "expr": "('naocritico' if (subs(diff(x**2+y**2,x),{x:0,y:0})!=0 or subs(diff(x**2+y**2,y),{x:0,y:0})!=0) else ('sela' if subs((diff(x**2+y**2,x,2)*diff(x**2+y**2,y,2)-diff(x**2+y**2,x,y)**2),{x:0,y:0})<0 else ('inconclusivo' if subs((diff(x**2+y**2,x,2)*diff(x**2+y**2,y,2)-diff(x**2+y**2,x,y)**2),{x:0,y:0})==0 else ('min' if subs(diff(x**2+y**2,x,2),{x:0,y:0})>0 else 'max'))))",
    "numeric": "'min'"
   },
   "optionValues": {
    "d": "'min'",
    "c": "'max'",
    "a": "'sela'",
    "b": "'inconclusivo'"
   },
   "result": {
    "ok": true,
    "method": "sympy+independente",
    "ranAt": "2026-10-23T02:51:37.723Z",
    "details": "valor = min; checagem independente ok"
   }
  },
