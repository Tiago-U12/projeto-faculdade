  "id": "c2-derivadas-003",
  "disciplineId": "calculo2",
  "topicId": "derivadas",
  "subtopic": "Constante multiplicativa",
  "difficulty": "facil",
  "scope": "aula",
  "type": "multiple-choice",
  "stem": "Encontre a derivada de $f(x)=\\pi x^{2}$.",
