{
  "name": "study-mastery",
  "private": true,
  "version": "0.6.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "sm": "tsx tools/sm.ts",
    "content:validate": "tsx tools/sm.ts validate",
    "content:coverage": "tsx tools/sm.ts coverage-report --write",
    "content:publish": "tsx tools/sm.ts publish",
    "e2e": "tsx tests/e2e/run.ts",
    "progress": "tsx tools/progress.ts",
    "sandbox:install": "npm --prefix tools/sandbox install --no-audit --no-fund",
    "e2e:render": "tsx tests/e2e/render-all.ts",
    "e2e:offline": "tsx tests/e2e/offline.ts",
    "test:pwa": "node --experimental-strip-types tests/pwa.test.mjs",
    "e2e:homologacao": "tsx tests/e2e/homologacao.ts",
    "e2e:redirects": "tsx tests/e2e/canonical-navigation.ts",
    "e2e:v06": "tsx tests/e2e/v06.ts",
    "e2e:a52": "tsx tests/e2e/a52-diagnostico.ts",
    "test:db": "vitest run tests/db",
    "test:integration": "tsx tests/integration/supabase-real.ts",
    "e2e:feedback": "tsx tests/e2e/feedback.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "@vitejs/plugin-react": "^4.7.0",
    "katex": "^0.16.11",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "axe-core": "^4.10.3",
    "jsdom": "^29.1.1",
    "pg": "^8.23.1",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
