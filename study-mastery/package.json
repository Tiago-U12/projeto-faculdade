{
  "name": "study-mastery",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "sm": "tsx tools/sm.ts",
    "content:validate": "tsx tools/sm.ts validate",
    "content:coverage": "tsx tools/sm.ts coverage-report --write",
    "content:publish": "tsx tools/sm.ts publish",
    "e2e": "tsx tests/e2e/run.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "katex": "^0.16.11",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}