{
  "name": "trocaticket-front",
  "private": true,
  "version": "0.4.2",
  "type": "module",
  "scripts": {
    "dev": "vite --mode pages --host 127.0.0.1",
    "build": "vite build --mode pages",
    "build:pages": "vite build --mode pages",
    "preview": "vite preview --mode pages --host 127.0.0.1",
    "format": "prettier --write src tests public/data package.json index.html vite.config.js",
    "format:check": "prettier --check src tests public/data package.json index.html vite.config.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "prettier": "^3.9.8",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
